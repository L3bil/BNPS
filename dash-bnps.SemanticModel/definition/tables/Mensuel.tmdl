table Mensuel
	lineageTag: 230ffc4a-edd2-4083-a6c1-52a65d44faca

	measure 'Mois choisi' = SELECTEDVALUE(Periodes[Mois], "2026-08")
		lineageTag: 0c74ced7-577e-4fd6-b33f-ac2a6abf67fe

	measure 'Ordre choisi' = SELECTEDVALUE(Periodes[Ordre], 24320)
		lineageTag: 72eb096f-c2cb-45f3-bf32-33f6a1167faf

	measure 'CA du mois' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SUM(Mensuel[CA]), Mensuel[Mois] = m))
		formatString: #,0
		lineageTag: 1f267435-4992-488c-84db-3ea48b4e65ac

	measure Fréquentation = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SUM(Mensuel[Tickets]), Mensuel[Mois] = m))
		formatString: #,0
		lineageTag: 78026df3-443d-47a7-aae5-ff71882da74d

	measure 'Panier moyen' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Mensuel[Panier]), Mensuel[Mois] = m))
		formatString: #,0.00
		lineageTag: eb3f7d41-ff61-4e1a-a255-aee2d2e17753

	measure 'NPS du semestre' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Mensuel[NPS]), Mensuel[Mois] = m))
		formatString: 0.0
		lineageTag: 5e0601b2-8420-49e3-8d45-a835457c522c

	measure 'Score Baromètre' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Mensuel[Barometre]), Mensuel[Mois] = m))
		formatString: 0.0
		lineageTag: 555f4d9a-3b9a-4668-9823-ea0865111100

	measure 'Répondants NPS' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Mensuel[Repondants]), Mensuel[Mois] = m))
		formatString: #,0
		lineageTag: 8a3ad176-5f35-4d94-8d83-9915b9bb1d3d

	measure 'CA année précédente' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SUM(Mensuel[CA_N1]), Mensuel[Mois] = m))
		formatString: #,0
		lineageTag: 17236c9d-378f-4ef3-b139-2eb745df763c

	measure 'Tickets année précédente' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SUM(Mensuel[Tickets_N1]), Mensuel[Mois] = m))
		formatString: #,0
		lineageTag: adeca76f-602c-4243-8e7c-1c3415d48cc8

	measure 'Période NPS' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SELECTEDVALUE(Mensuel[Periode_NPS]), Mensuel[Mois] = m), "Choisir un magasin")
		lineageTag: 61d605ad-81fa-4fcc-95ef-f0eebe893d9d

	measure 'Vague Baromètre' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SELECTEDVALUE(Mensuel[Vague]), Mensuel[Mois] = m), "Choisir un magasin")
		lineageTag: 859247de-0fdf-4a4c-aadd-2d2214c28754

	measure 'Couverture du mois' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(SELECTEDVALUE(Mensuel[Couverture]), Mensuel[Mois] = m), "Choisir un magasin")
		lineageTag: b859a5d5-1283-4ff0-adb0-a127f693c8ca

	measure 'Évolution CA annuelle' = DIVIDE([CA du mois] - [CA année précédente], [CA année précédente])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: fd84e26e-bc24-4a1b-82c5-48d366dade0d

	measure 'Évolution fréquentation annuelle' = DIVIDE([Fréquentation] - [Tickets année précédente], [Tickets année précédente])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 31c9901c-6464-4c38-abdb-e08d1aa197ed

	measure 'CA évolution' = VAR o = MAX(Mensuel[Ordre]) RETURN IF(HASONEVALUE(Magasins[Code]) && o <= [Ordre choisi] && o > [Ordre choisi] - 12, SUM(Mensuel[CA]))
		formatString: #,0
		lineageTag: 77b5ad6d-4630-437a-b818-8e93a108e03f

	measure 'CA évolution N-1' = VAR o = MAX(Mensuel[Ordre]) RETURN IF(HASONEVALUE(Magasins[Code]) && o <= [Ordre choisi] && o > [Ordre choisi] - 12, SUM(Mensuel[CA_N1]))
		formatString: #,0
		lineageTag: f11015e3-b88e-44ab-9270-cfe38489597a

	measure 'Fréquentation évolution' = VAR o = MAX(Mensuel[Ordre]) RETURN IF(HASONEVALUE(Magasins[Code]) && o <= [Ordre choisi] && o > [Ordre choisi] - 12, SUM(Mensuel[Tickets]))
		formatString: #,0
		lineageTag: ae675ba5-9062-4333-8160-14c8c3842e58

	measure 'Fréquentation évolution N-1' = VAR o = MAX(Mensuel[Ordre]) RETURN IF(HASONEVALUE(Magasins[Code]) && o <= [Ordre choisi] && o > [Ordre choisi] - 12, SUM(Mensuel[Tickets_N1]))
		formatString: #,0
		lineageTag: 833681e4-ae76-43f9-9b3c-d9c222b01ff6

	measure 'Mentions négatives' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Themes[Negatives]), Themes[Mois] = m))
		formatString: 0
		lineageTag: 2712bb91-58e6-4cf5-a2e1-d56a8834dfa0

	measure 'Mentions du thème' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Themes[Mentions]), Themes[Mois] = m))
		formatString: 0
		lineageTag: 0c78874f-f0ad-4792-b76f-52ff7a7b6260

	measure 'Base analysable' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(MAX(Themes[Analysables]), Themes[Mois] = m))
		formatString: 0
		lineageTag: 845eb6e3-eb8a-465f-840d-35742606027c

	measure 'Part négative du thème' = DIVIDE([Mentions négatives], [Base analysable])
		formatString: 0%
		lineageTag: d7fa45e8-4b84-425e-ad87-2483887dc45d

	measure 'Niveau du thème' = VAR n = [Mentions négatives] VAR p = [Part négative du thème] RETURN SWITCH(TRUE(), ISBLANK(n), BLANK(), n = 0, "Aucune mention négative", n < 3, "Isolé", p >= 0.5, "Prioritaire", "Récurrent")
		lineageTag: 3e59fb9b-d8d7-4f25-9449-824ea892d39b

	measure 'Couleur du thème' = SWITCH([Niveau du thème], "Prioritaire", "#DC3545", "Récurrent", "#F59E0B", "Isolé", "#FDE6BA", "#E6EDF5")
		lineageTag: ea61b04a-1973-48ab-a64e-71c760546b84

	measure 'Commentaire du mois' = IF(HASONEVALUE(Magasins[Code]) && SELECTEDVALUE(Verbatims[Mois]) = [Mois choisi], 1)
		lineageTag: 22d1a3d2-5a2d-40ca-9196-33468e95829a

	measure 'Titre de page' = "Expérience client & performance | " & SELECTEDVALUE(Magasins[Magasin], "Choisir un magasin")
		lineageTag: 817c1581-c425-46ba-ad5d-ab2c0a681022

	measure 'Détail NPS' = [Période NPS] & " · " & IF(ISBLANK([Répondants NPS]), "effectif indisponible", FORMAT([Répondants NPS], "0") & " réponses")
		lineageTag: d745344d-96d3-4bf7-bafa-7a674a4c4eb6

	measure 'Détail CA' = IF(ISBLANK([Évolution CA annuelle]), "Comparaison annuelle indisponible", FORMAT([Évolution CA annuelle], "+0.0%;-0.0%;0.0%") & " vs même mois N-1")
		lineageTag: 94dfd028-be97-4184-afa7-fa3d5cac04eb

	measure 'Détail fréquentation' = IF(ISBLANK([Évolution fréquentation annuelle]), "Comparaison annuelle indisponible", FORMAT([Évolution fréquentation annuelle], "+0.0%;-0.0%;0.0%") & " vs même mois N-1")
		lineageTag: 8fba6f5c-62bb-4bc2-bbc3-c8355ef93e31

	measure 'Détail panier' = "CA / nombre de tickets"
		lineageTag: 35d99ad7-5109-4efc-b4e7-7da85e31007b

	measure 'Commentaires du mois' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(DISTINCTCOUNT(Verbatims[Identifiant]), Verbatims[Mois] = m))
		formatString: 0
		lineageTag: 1db5b3d2-8ffd-45c7-aeb6-9e1a33da2c32

	measure 'Commentaires analysables' = VAR m = [Mois choisi] RETURN IF(HASONEVALUE(Magasins[Code]), CALCULATE(DISTINCTCOUNT(Verbatims[Identifiant]), Verbatims[Mois] = m, Verbatims[Sentiment] <> "Non analysable"))
		formatString: 0
		lineageTag: 10c3d6a7-8af6-42a3-ba01-b365d90a9754

	measure 'Commentaires négatifs' = VAR m = [Mois choisi] RETURN IF(NOT ISBLANK([Commentaires analysables]), COALESCE(CALCULATE(DISTINCTCOUNT(Verbatims[Identifiant]), Verbatims[Mois] = m, Verbatims[Sentiment] = "Négatif"), 0))
		formatString: 0
		lineageTag: 6d195776-7d97-42fb-8562-a4514f6fc8b8

	measure 'Part verbatims négatifs' = DIVIDE([Commentaires négatifs], [Commentaires analysables])
		formatString: 0.0%
		lineageTag: ef83713c-7399-4397-84a0-1a44afe65efa

	measure 'Détail verbatims' = IF(NOT HASONEVALUE(Magasins[Code]), "Choisir un magasin", IF(ISBLANK([Commentaires du mois]), "Aucun commentaire disponible", FORMAT([Commentaires négatifs], "0") & "/" & FORMAT([Commentaires analysables], "0") & " analysables · " & FORMAT([Commentaires du mois], "0") & " commentaires"))
		lineageTag: 68f49c1a-1cb4-4a61-aae5-8aa5949cf9de

