	partition Mensuel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:/Users/abdellah.ngar/Desktop/BNPS/outputs/powerbi/Mensuel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Code", type text}, {"Mois", type text}, {"Ordre", Int64.Type}, {"CA", type number}, {"Tickets", type number}, {"Panier", type number}, {"CA_N1", type number}, {"Tickets_N1", type number}, {"NPS", type number}, {"Repondants", type number}, {"Periode_NPS", type text}, {"Barometre", type number}, {"Vague", type text}, {"Couverture", type text}, {"Perimetre_alertes", type logical}}, "en-US")
				in
				    Types

